# Backend
ENVIRONMENT=development
DATABASE_URL=sqlite:///./wikidev.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_IPS=

# Cookies y sesiones (en producción activar COOKIE_SECURE=true bajo HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=24

# Ejecución de código: disabled | docker | local_unsafe
# En ENVIRONMENT=production el valor por defecto es "disabled".
CODE_EXECUTION_MODE=local_unsafe
MAX_CONCURRENT_EXECUTIONS=4

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
